{
  "name": "@enschedule/cli",
  "version": "2.0.0",
  "description": "Bun CLI for Enschedule",
  "type": "module",
  "module": "dist/index.js",
  "main": "dist/index.js",
  "types": "dist/index.js",
  "dist-entry": "dist/index.js",
  "scripts": {
    "test": "bun test",
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --target bun --format esm --external @enschedule/types --external @enschedule/worker-api",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "start": "bun ./src/index.ts"
  },
  "bin": {
    "enschedule": "./dist/index.js"
  },
  "keywords": ["cli", "enschedule", "bun"],
  "author": "Ricsam <oss@ricsam.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricsam/enschedule.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@enschedule/types": "workspace:*",
    "@enschedule/worker-api": "workspace:*",
    "axios": "^1.6.5",
    "cli-table": "^0.3.11",
    "commander": "^11.1.0",
    "cron-parser": "^5.4.0",
    "debug": "^4.4.0",
    "figlet": "^1.7.0",
    "glob": "^11.0.0",
    "inquirer": "^8.0.0",
    "js-yaml": "^4.1.0",
    "yaml": "^2.3.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/cli-table": "^0.3.4",
    "@types/debug": "^4.1.12",
    "@types/inquirer": "^8",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.9.3"
  }
}
