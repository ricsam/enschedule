{
  "name": "@enschedule/worker-cli",
  "version": "2.0.0",
  "description": "Bun CLI for the Enschedule worker",
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build ./src/cli.ts --outfile ./dist/cli.js --target bun --format esm --external @enschedule/worker",
    "start": "bun ./src/cli.ts",
    "lint": "tsc --noEmit",
    "test": "bun test"
  },
  "bin": {
    "enschedule-worker": "dist/cli.js"
  },
  "keywords": ["cli", "worker", "enschedule", "bun"],
  "author": "Ricsam <oss@ricsam.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricsam/enschedule.git",
    "directory": "packages/worker-cli"
  },
  "dependencies": {
    "@enschedule/worker": "workspace:*",
    "commander": "^12.1.0",
    "debug": "^4.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/debug": "^4.1.12",
    "typescript": "^5.9.3"
  }
}
