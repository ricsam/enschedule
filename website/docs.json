{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Enschedule",
  "description": "Build, schedule, and operate PostgreSQL-backed jobs with Bun workers.",
  "colors": {
    "primary": "#0E6336",
    "light": "#3ECC5F",
    "dark": "#148347"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "concepts"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "guides/functions",
              "guides/workers",
              "guides/schedules",
              "guides/runs"
            ]
          },
          {
            "group": "Operate",
            "pages": [
              "deployment/docker",
              "deployment/helm",
              "deployment/upgrades"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/configuration",
              "reference/cli",
              "reference/statuses"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "braces",
        "groups": [
          {
            "group": "API",
            "pages": [
              "api/overview",
              "api/authentication"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": {
              "source": "openapi.json",
              "directory": "api-reference"
            }
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/ricsam/enschedule"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://enschedule-irqfaf85i4ig.r5d.app"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ricsam/enschedule"
    },
    "links": [
      {
        "header": "Learn",
        "items": [
          {
            "label": "Quickstart",
            "href": "/quickstart"
          },
          {
            "label": "Core concepts",
            "href": "/concepts"
          },
          {
            "label": "API reference",
            "href": "/api/overview"
          }
        ]
      },
      {
        "header": "Project",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/ricsam/enschedule"
          },
          {
            "label": "Issues",
            "href": "https://github.com/ricsam/enschedule/issues"
          },
          {
            "label": "Dashboard",
            "href": "https://enschedule-irqfaf85i4ig.r5d.app"
          }
        ]
      }
    ]
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "params": {
      "expanded": "closed"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ],
      "defaults": "required",
      "prefill": true
    },
    "url": "full"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-spec",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "search": {
    "prompt": "Search Enschedule docs"
  },
  "metadata": {
    "timestamp": true
  },
  "seo": {
    "indexing": "navigable",
    "organization": {
      "name": "Enschedule",
      "url": "https://github.com/ricsam/enschedule",
      "sameAs": [
        "https://github.com/ricsam/enschedule"
      ]
    }
  },
  "markdown": {
    "schema": true,
    "instructions": [
      "Use Enschedule 2 examples based on Bun and PostgreSQL.",
      "Use /api as the supported API base path; do not use the removed /api/v1 contract."
    ]
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "Return to the [Enschedule introduction](/)."
    }
  }
}
