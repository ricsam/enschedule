{
  "name": "@enschedule/dashboard",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./server/index.ts"
  },
  "scripts": {
    "routes:generate": "bun ./scripts/generate-routes.ts",
    "dev": "bun run routes:generate && bun --hot ./server/main.ts",
    "build": "bun run routes:generate && vite build",
    "start": "bun ./server/main.ts",
    "docker:start": "bun ./server/main.ts",
    "typecheck": "bun run routes:generate && tsc --noEmit",
    "test": "bun test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@enschedule/pg-driver": "workspace:*",
    "@enschedule/types": "workspace:*",
    "@enschedule/worker": "workspace:*",
    "@enschedule/worker-api": "workspace:*",
    "@fontsource/roboto": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "@richie-router/core": "0.1.6",
    "@richie-router/react": "0.1.8",
    "@richie-router/server": "0.1.9",
    "@richie-router/tooling": "0.1.8",
    "@richie-rpc/client": "2.0.1",
    "@richie-rpc/openapi": "2.0.0",
    "@richie-rpc/react-query": "2.0.1",
    "@richie-rpc/server": "2.0.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "ajv": "^8.17.1",
    "date-fns": "^4.1.0",
    "monaco-editor": "^0.52.2",
    "pascal-case": "^4.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sentence-case": "^4.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}
