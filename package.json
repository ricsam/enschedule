{
  "name": "enschedule",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*",
    "functions/*",
    "website"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=test-worker --filter=@enschedule/dashboard",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "bun test packages/types packages/cli apps/dashboard packages/pg-driver",
    "playwright": "playwright",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "dependencies": {
    "@changesets/cli": "^2.29.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.14",
    "eslint": "^9.39.4",
    "prettier": "^3.8.2",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  }
}
