{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Enschedule",
  "description": "Build, schedule, and operate PostgreSQL-backed jobs with Bun workers.",
  "colors": {
    "primary": "#0E6336",
    "light": "#3ECC5F",
    "dark": "#148347"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "concepts"
            ]
          },
          {
            "group": "Build",
            "pages": [
              "guides/functions",
              "guides/workers",
              "guides/schedules",
              "guides/runs"
            ]
          },
          {
            "group": "Deploy",
            "pages": [
              "deployment/docker",
              "deployment/helm",
              "deployment/upgrades"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/configuration",
              "reference/cli",
              "reference/statuses"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "braces",
        "groups": [
          {
            "group": "API",
            "pages": [
              "api/overview",
              "api/authentication"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/health",
              "api-reference/schedules",
              "api-reference/runs",
              "api-reference/workers",
              "api-reference/definitions"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/ricsam/enschedule"
      }
    ],
    "primary": {
      "type": "button",
      "label": "View demo",
      "href": "https://demo-irqfaf85i4ig.r5d.app"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/ricsam/enschedule"
    },
    "links": [
      {
        "header": "Learn",
        "items": [
          { "label": "Quickstart", "href": "/quickstart" },
          { "label": "Core concepts", "href": "/concepts" },
          { "label": "API reference", "href": "/api/overview" }
        ]
      },
      {
        "header": "Project",
        "items": [
          { "label": "GitHub", "href": "https://github.com/ricsam/enschedule" },
          { "label": "Issues", "href": "https://github.com/ricsam/enschedule/issues" },
          { "label": "Dashboard demo", "href": "https://demo-irqfaf85i4ig.r5d.app" }
        ]
      }
    ]
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "javascript", "python"],
      "defaults": "required"
    }
  },
  "search": {
    "prompt": "Search Enschedule docs"
  }
}
