    "type": "git",
    "url": "git+https://github.com/ricsam/enschedule.git",
    "directory": "packages/worker"
  },
  "scripts": {
    "build": "bun build ./index.ts ./api.ts --outdir ./dist --target bun --format esm --external @enschedule/pg-driver --external @enschedule/types --external @enschedule/worker-api --external @richie-rpc/server",
