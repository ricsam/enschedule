{
  "name": "@enschedule/pg-driver",
  "version": "2.0.0",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./schema": "./schema.ts",
    "./migrate": "./migrate.ts"
  },
  "main": "./index.ts",
  "types": "./index.ts",
  "keywords": ["worker", "enschedule", "drizzle", "postgresql", "bun"],
  "author": "Ricsam <oss@ricsam.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricsam/enschedule.git",
    "directory": "packages/pg-driver"
  },
  "scripts": {
    "build": "bun build ./index.ts ./migrate.ts --outdir ./dist --target bun --format esm --external @enschedule/types --external drizzle-orm",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun ./migrate.ts"
  },
  "files": ["index.ts", "backend.ts", "access.ts", "schema.ts", "database.ts", "migrate.ts", "drizzle.config.ts", "drizzle", "dist"],
  "dependencies": {
    "@enschedule/types": "workspace:*",
    "cron-parser": "^5.4.0",
    "drizzle-orm": "^0.45.2",
    "jsonwebtoken": "^9.0.3",
    "nafs": "^0.1.10",
    "pascal-case": "^4.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/jsonwebtoken": "^9.0.10",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3"
  }
}
